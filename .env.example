# =====================================================================
#  Cactus Inventory — Variables de entorno
#  Copiar a .env en la raiz del proyecto. El compose las levanta.
# =====================================================================

# ----- LLM -----
# Backend por defecto al arranque del gateway (se puede override runtime
# con `cloud on|off` o `cloud llm=openrouter|stt=elevenlabs ...`).
LLM_BACKEND=needle                       # needle | openrouter
OPENROUTER_API_KEY=                      # requerida si arrancas con --profile with-openrouter
# DeepSeek V4 Flash: $0.09/M in, $0.18/M out. Smart, tool calling solido.
# Alternativa gratis: google/gemma-4-31b-it:free (free tier con rate limits)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE=https://openrouter.ai/api/v1

# ----- STT -----
STT_BACKEND=whisper                      # whisper | elevenlabs
WHISPER_MODEL=small                      # tiny | base | small | medium

# ----- TTS -----
TTS_BACKEND=kokoro                       # kokoro | elevenlabs
KOKORO_VOICE=ef_dora                     # voz por defecto de Kokoro
KOKORO_LANG=e                            # 'e' espanol
KOKORO_SPEED=1.0

# ----- Eleven Labs (cloud, perfil with-elevenlabs) -----
# Requeridas para que elevenlabs-service funcione. Sin key, el servicio
# arranca pero responde 503 en /transcribe y /speak.
ELEVENLABS_API_KEY=                      # sk_xxxxxxxxxxxxxxxxxxxx
ELEVENLABS_BASE=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default)
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT=pcm_24000          # PCM int16 LE mono 24k (match tts_client.py)

# ----- Narrador (textos naturales para TTS) -----
# "default" -> templates hardcodeados (rapido, gratis, sin red)
# "llm"     -> reescribe con OpenRouter (mas natural, depende de API key)
# Se puede override en runtime: `cloud narrator=llm` o `models select <slug>`
NARRATOR_BACKEND=default
NARRATOR_MODEL=google/gemma-4-31b-it:free   # Free tier de Google, ideal para narrador

# ----- Conversacional (B-Link: asistente charlatan, saludos, general) -----
# Solo OpenRouter provee esta capacidad. Usa el free tier para que sea gratis.
# Si OpenRouter no esta disponible, se cae al LLM principal (que igual va
# a devolver tool calls aunque no apliquen).
CONVERSATION_MODEL=google/gemma-4-31b-it:free

# ----- Toggle global (puede ser override en runtime con `cloud on`) -----
# CLOUD_ENABLED=true -> al arrancar ya usa cloud en LLM/STT/TTS
CLOUD_ENABLED=false
