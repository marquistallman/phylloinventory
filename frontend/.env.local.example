# URL interna del api-gateway (backend), SOLO para el servidor de Next.js.
# La usa el rewrite de next.config.js para reenviar /api/* al backend real.
# El navegador nunca ve esta variable ni esta URL.
API_GATEWAY_INTERNAL_URL=http://localhost:8200

# API key (dejar vacía en dev si el backend no tiene API_KEY configurada).
# Esta SI es pública: el navegador la manda como header X-API-Key.
NEXT_PUBLIC_API_KEY=
